{
  "name": "catalyst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:ai": "node --conditions=react-server --import tsx scripts/evaluate-ai.ts",
    "evaluate:rooms": "tsx scripts/evaluate-rooms.ts",
    "check:production": "tsx scripts/check-production.ts",
    "db:migrate": "tsx scripts/migrate-rooms.ts",
    "verify:secrets": "tsx scripts/verify-secrets.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@libsql/client": "^0.18.0",
    "@xyflow/react": "^12.9.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
