# Server only. Copy this file to .env.local; never commit your actual key.
GEMINI_API_KEY=
# Optional model override. Verified against official documentation Nov 18, 2026.
GEMINI_MODEL=gemini-3.5-flash-lite

# Exact browser-facing origin. Required for production behind a reverse proxy.
# Local default derives the actual request Host (127.0.0.1:3100).
# APP_ORIGIN=https://your-approved-host.example

# Mandatory on Vercel: a libSQL-engine managed database, not a local file.
# Keep all variables server-only. Vercel fails closed even if the flag below is false.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Set true on other ephemeral/serverless or multi-instance hosting to fail closed
# rather than accidentally using local SQLite.
REQUIRE_MANAGED_ROOMS=false
